# ---- Supabase (public values are safe in clients; service role is SERVER ONLY) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (admin app + Edge Functions). NEVER prefix with NEXT_PUBLIC_ / EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Maps Platform (use separate, restricted keys per platform) ----
# Web: Maps JavaScript API + Places API (New). Restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_WEB_KEY=
# Android: Maps SDK for Android. Restrict by package name + SHA-1.
GOOGLE_MAPS_ANDROID_KEY=
# Server only: Routes API / Geocoding. Restrict by IP / keep in Edge Functions.
GOOGLE_MAPS_SERVER_KEY=

# ---- OAuth (configured in Supabase Auth dashboard; client IDs below are not secrets) ----
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# ---- Push (Expo Push or FCM) ----
EXPO_PUSH_ACCESS_TOKEN=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ANDROID_APPLICATION_ID=com.solotrav.app
